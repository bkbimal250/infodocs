# ============================================
# React/Vite Frontend Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to version control
# Note: Vite requires VITE_ prefix for environment variables

# ============================================
# API Configuration
# ============================================
# Public backend URL for certificate/static asset helpers only.
# Authenticated requests always use /api through the same-origin proxy.
VITE_API_BASE_URL=https://infodocs.api.d0s369.co.in/api

# ============================================
# Application Settings (Optional)
# ============================================
# VITE_APP_NAME=SPA Docs
# VITE_APP_VERSION=1.0.0
